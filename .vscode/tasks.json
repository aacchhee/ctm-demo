{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview website",
      "type": "shell",
      "command": "quarto preview",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Build website",
      "type": "shell",
      "command": "quarto render",
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
